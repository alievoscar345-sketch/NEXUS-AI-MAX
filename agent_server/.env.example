# Generate a long random value; authenticates NEXUS Android clients.
NEXUS_AGENT_API_KEY=replace-with-a-long-random-secret
# Keep provider credentials on the server, never in the APK.
NEXUS_LLM_BASE_URL=https://anymodel.org/v1
NEXUS_LLM_MODEL=claude-fable-5-2
NEXUS_LLM_API_KEY=replace-with-provider-key
# Optional Tavily search integration.
TAVILY_API_KEY=
NEXUS_AGENT_DB=/data/nexus-agent.db
NEXUS_AGENT_WORKSPACE=/data/workspace
NEXUS_AGENT_MAX_STEPS=12
NEXUS_AGENT_MAX_TASK_SECONDS=1800

# Optional multi-provider registry. Keys are referenced by environment-variable name.
# When configured, this replaces the legacy single-provider settings above.
# NEXUS_MODEL_PROVIDERS=[{"id":"primary","base_url":"https://provider.example/v1","model":"model-id","api_key_env":"PRIMARY_MODEL_API_KEY","priority":10,"purposes":["general","planning","evaluation"],"enabled":true}]
# NEXUS_MODEL_ROUTE_PLANNING=primary,backup
# NEXUS_MODEL_ROUTE_EVALUATION=primary
# PRIMARY_MODEL_API_KEY=replace-me
