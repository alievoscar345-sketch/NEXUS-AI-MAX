# Generate a long random value; authenticates NEXUS Android clients.
NEXUS_AGENT_API_KEY=replace-with-a-long-random-secret
# Encryption key for user-managed provider credentials. Generate with: openssl rand -base64 32
# Back this key up separately; losing it makes stored provider keys unrecoverable.
NEXUS_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Keep provider credentials on the server, never in the APK.
NEXUS_LLM_BASE_URL=https://anymodel.org/v1
NEXUS_LLM_MODEL=claude-fable-5-2
NEXUS_LLM_API_KEY=replace-with-provider-key
# Optional Tavily search integration.
TAVILY_API_KEY=
NEXUS_AGENT_DB=/data/nexus-agent.db
NEXUS_AGENT_WORKSPACE=/data/workspace
# Legacy metadata default only; does not cap dynamically planned task steps.
NEXUS_AGENT_DEFAULT_TASK_STEPS=24
# Maximum size for one published task artifact (default 2 GiB).
NEXUS_AGENT_MAX_ARTIFACT_BYTES=2147483648
NEXUS_AGENT_MAX_PROJECT_FILE_BYTES=52428800
# Immutable task workspace checkpoints; rolling retention keeps the newest five per task.
NEXUS_AGENT_MAX_CHECKPOINT_BYTES=2147483648
NEXUS_AGENT_MAX_CHECKPOINT_FILES=50000
NEXUS_AGENT_CHECKPOINT_RETENTION=5
# Repository checkout safety bounds: archive download, extracted bytes, and entry count.
NEXUS_AGENT_MAX_CHECKOUT_ARCHIVE_BYTES=536870912
NEXUS_AGENT_MAX_CHECKOUT_UNPACKED_BYTES=2147483648
NEXUS_AGENT_MAX_CHECKOUT_FILES=50000
NEXUS_AGENT_MAX_GITHUB_ARTIFACT_ARCHIVE_BYTES=536870912
NEXUS_AGENT_CONTINUATION_DELAY_SECONDS=5
# Optional isolated code execution. Preload a trusted runner image and pin it by sha256 digest.
# The backend must run as a non-root user with Docker access; no image is pulled automatically.
NEXUS_SANDBOX_IMAGE=

# Optional multi-provider registry. Keys are referenced by environment-variable name.
# When configured, this replaces the legacy single-provider settings above.
# NEXUS_MODEL_PROVIDERS=[{"id":"primary","base_url":"https://provider.example/v1","model":"model-id","api_key_env":"PRIMARY_MODEL_API_KEY","priority":10,"purposes":["general","planning","evaluation"],"capabilities":["vision"],"enabled":true}]
# NEXUS_MODEL_ROUTE_PLANNING=primary,backup
# NEXUS_MODEL_ROUTE_EVALUATION=primary
# PRIMARY_MODEL_API_KEY=replace-me

# Optional benchmark-aware routing metadata per model (scores normalized to 0..100).
# Scores must be sourced from named, dated evaluations; do not invent or silently refresh them.
# Supported task categories: general, coding, research, math, vision, writing.
# NEXUS_MODEL_PROVIDERS=[{"id":"coder","base_url":"https://provider.example/v1","model":"model-id","api_key_env":"CODER_API_KEY","priority":10,"purposes":["general","planning","evaluation"],"benchmark_scores":{"coding":92,"general":84},"cost_per_million_tokens":2.5,"latency_ms":850,"ranking_source":"SWE-bench Verified + internal eval","ranking_updated_at":"2026-11-20"}]

# Run the worker inside the API process for simple deployments. Set false when using the separate app.worker service in docker-compose.yml.
NEXUS_AGENT_WORKER_ENABLED=true

# Durable worker controls (one worker process; concurrent tasks share SQLite safely).
NEXUS_AGENT_WORKER_CONCURRENCY=2
NEXUS_AGENT_WORKER_POLL_SECONDS=2
NEXUS_AGENT_STEP_MAX_ATTEMPTS=3
NEXUS_AGENT_RETRY_BASE_SECONDS=10

# Optional isolated code execution. Build/push agent_server/sandbox/Dockerfile, then
# set the exact preloaded registry image digest (repository@sha256:...).
# Mount the Docker socket into the backend container and add the socket's host GID.
# If the backend's /data/workspace path differs from the host path, set the host path here.
NEXUS_SANDBOX_IMAGE=
NEXUS_SANDBOX_HOST_WORKSPACE_ROOT=
# Optional protected Docker daemon endpoint, e.g. ssh://runner-user@runner-host.
# Leave unset to use the local Docker socket (requires socket mount and group access).
# DOCKER_HOST=ssh://runner-user@runner-host
